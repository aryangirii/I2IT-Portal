# Copy to .env.local. Never commit actual secrets.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TNP_ADMIN_EMAILS=tnp@example.edu
# Local Docker database. Use your provider's pooled TLS URL on Vercel.
DATABASE_URL=postgresql://placement:placement_local_only@localhost:5433/placement
# Migration connection may be the direct database URL.
DATABASE_DIRECT_URL=
DB_POOL_MAX=5
# Development only: disabled on Vercel AND whenever NODE_ENV=production.
LOCAL_DEMO_ENABLED=false
LOCAL_DEMO_PASSWORD=
